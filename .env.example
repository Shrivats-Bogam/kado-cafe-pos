# Kado Cafe — environment variables
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored; never commit real keys.

# --- Supabase (optional but recommended for multi-device sync) ---
# Get these from your Supabase project: Settings → API.
# The anon key is safe to ship in the client bundle ONLY when Row-Level Security
# is enabled with restrictive policies. For a single-cafe MVP the schema disables
# RLS — tighten it before going public.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Anthropic Claude (optional — powers AI Insights) ---
# IMPORTANT: shipping a Claude API key in the client bundle exposes it to anyone
# who opens DevTools. This is acceptable only for a single-owner private device.
# For production, route calls through a Supabase Edge Function (see src/lib/ai.js
# for the prepared abstraction) and remove this variable from the client.
VITE_ANTHROPIC_API_KEY=
